<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>CatYuka — iOS 27 Spatial Glass</title>

    <!-- Mode Web App Native iOS -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="CatYuka">

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/html5-qrcode"></script>

    <style>
        :root {
            --safe-top: env(safe-area-inset-top, 18px);
            --safe-bottom: env(safe-area-inset-bottom, 24px);
        }

        * {
            -webkit-tap-highlight-color: transparent;
            box-sizing: border-box;
        }

        body {
            background-color: #060200;
            color: #fffaf5;
            padding-top: var(--safe-top);
            padding-bottom: calc(var(--safe-bottom) + 32px);
            overflow-x: hidden;
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", system-ui, sans-serif;
        }

        /* === MOTEUR DE LUMIÈRE FLUIDE iOS 27 === */
        .spatial-bg {
            position: fixed;
            inset: 0;
            z-index: -1;
            overflow: hidden;
            background: radial-gradient(circle at 50% -15%, #3b1304 0%, #120501 58%, #040100 100%);
        }
        .caustic-blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(75px);
            opacity: 0.85;
            mix-blend-mode: screen;
            animation: floatLiquid 16s infinite alternate cubic-bezier(0.4, 0, 0.2, 1);
        }
        .b-1 { width: 380px; height: 380px; background: radial-gradient(circle, #ff6a00 0%, #c2410c 70%); top: -10%; left: -18%; }
        .b-2 { width: 340px; height: 340px; background: radial-gradient(circle, #fb923c 0%, #b45309 75%); top: 28%; right: -22%; animation-delay: -5s; }
        .b-3 { width: 320px; height: 320px; background: radial-gradient(circle, #f97316 0%, #be185d 75%); bottom: -12%; left: 6%; animation-delay: -9s; }
        .b-4 { width: 250px; height: 250px; background: radial-gradient(circle, #fde047 0%, #ea580c 70%); top: 52%; left: 28%; opacity: 0.5; animation-delay: -12s; }

        @keyframes floatLiquid {
            0% { transform: translate3d(0, 0, 0) scale(1) rotate(0deg); }
            50% { transform: translate3d(32px, -38px, 0) scale(1.18) rotate(14deg); }
            100% { transform: translate3d(-24px, 28px, 0) scale(0.92) rotate(-10deg); }
        }

        /* === LENTILLE LIQUID GLASS iOS 27 (DOUBLE RÉFRACTION SPÉCULAIRE) === */
        .ios27-window {
            position: relative;
            background: linear-gradient(
                140deg,
                rgba(255, 255, 255, 0.16) 0%,
                rgba(255, 255, 255, 0.04) 48%,
                rgba(251, 146, 60, 0.07) 100%
            );
            backdrop-filter: blur(48px) saturate(230%) brightness(1.06);
            -webkit-backdrop-filter: blur(48px) saturate(230%) brightness(1.06);
            border-radius: 38px;
            border: 1px solid rgba(255, 255, 255, 0.30);
            box-shadow:
                0 30px 65px -15px rgba(0, 0, 0, 0.72),
                inset 0 2px 3px 0 rgba(255, 255, 255, 0.85),
                inset 0 -2px 5px 0 rgba(249, 115, 22, 0.38),
                inset 1.5px 0 2px 0 rgba(255, 255, 255, 0.32);
            transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .ios27-window::before {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: inherit;
            background: radial-gradient(110% 50% at 50% 0%, rgba(255, 255, 255, 0.25) 0%, transparent 62%);
            pointer-events: none;
        }

        /* === CAPSULE TACTILE BENTO === */
        .ios27-tile {
            position: relative;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.13) 0%, rgba(255, 255, 255, 0.03) 100%);
            backdrop-filter: blur(24px) saturate(200%);
            -webkit-backdrop-filter: blur(24px) saturate(200%);
            border: 1px solid rgba(255, 255, 255, 0.25);
            box-shadow:
                0 10px 24px -8px rgba(0, 0, 0, 0.4),
                inset 0 1.5px 1.5px 0 rgba(255, 255, 255, 0.6),
                inset 0 -1px 2px 0 rgba(249, 115, 22, 0.22);
            transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .ios27-tile:active {
            transform: scale(0.96);
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.24) 0%, rgba(249, 115, 22, 0.15) 100%);
        }

        /* === BOUTON ACTION LIQUIDE ORANGE === */
        .ios27-cta {
            position: relative;
            background: linear-gradient(135deg, rgba(249, 115, 22, 0.88) 0%, rgba(234, 88, 12, 0.68) 100%);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.7);
            box-shadow:
                0 16px 36px -6px rgba(249, 115, 22, 0.65),
                inset 0 2.5px 4px rgba(255, 255, 255, 0.9),
                inset 0 -2.5px 4px rgba(124, 45, 18, 0.5);
            transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .ios27-cta:active {
            transform: scale(0.96);
        }

        /* === DYNAMIC ISLAND iOS 27 === */
        .dynamic-island {
            background: rgba(8, 3, 1, 0.78);
            backdrop-filter: blur(35px) saturate(210%);
            -webkit-backdrop-filter: blur(35px) saturate(210%);
            border: 1px solid rgba(255, 255, 255, 0.28);
            box-shadow:
                0 18px 40px rgba(0, 0, 0, 0.65),
                inset 0 1px 1.5px rgba(255, 255, 255, 0.5);
            transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        }

        /* Laser optique */
        .scan-laser {
            position: absolute;
            left: 6%;
            right: 6%;
            height: 2.5px;
            background: linear-gradient(90deg, transparent, #fb923c, #ffffff, #fb923c, transparent);
            box-shadow: 0 0 14px 3px #f97316;
            animation: moveLaser 1.5s infinite ease-in-out alternate;
            pointer-events: none;
            z-index: 10;
        }
        @keyframes moveLaser {
            0% { top: 18%; }
            100% { top: 82%; }
        }

        #reader video {
            border-radius: 1.5rem;
            object-fit: cover;
        }
    </style>
</head>
<body class="select-none">

    <!-- Fond Liquide Spatial iOS 27 -->
    <div class="spatial-bg">
        <div class="caustic-blob b-1"></div>
        <div class="caustic-blob b-2"></div>
        <div class="caustic-blob b-3"></div>
        <div class="caustic-blob b-4"></div>
    </div>

    <!-- DYNAMIC ISLAND iOS 27 (Barre de statut & Vérification en direct) -->
    <header class="sticky top-2 z-40 mx-4 mt-2">
        <div class="max-w-md mx-auto dynamic-island rounded-full px-4 py-2.5 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full ios27-tile flex items-center justify-center text-base">
                    🐾
                </div>
                <div>
                    <h1 class="text-base font-black tracking-tight bg-gradient-to-r from-white via-orange-100 to-orange-300 bg-clip-text text-transparent leading-none">
                        CatYuka
                    </h1>
                    <p id="islandStatus" class="text-[10px] font-semibold text-orange-300/90 mt-0.5">
                        Triple Vérification Active
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-1.5 ios27-tile px-3 py-1 rounded-full">
                <span id="islandDot" class="w-2 h-2 rounded-full bg-orange-400 animate-pulse"></span>
                <span id="islandBadge" class="text-[10px] font-extrabold text-orange-100 tracking-wide">iOS 27</span>
            </div>
        </div>
    </header>

    <main class="max-w-md mx-auto p-4 space-y-5">

        <!-- FENÊTRE DE SCAN OPTIQUE CERTIFIÉ -->
        <div class="ios27-window p-5 space-y-4">
            <button onclick="toggleScanner()" id="scanBtn" class="w-full ios27-cta text-white py-4 rounded-[24px] text-base font-black flex items-center justify-center gap-2.5 tracking-tight">
                <span class="text-xl">📷</span>
                <span>Scanner & Vérifier un Produit</span>
            </button>

            <!-- Viseur Caméra avec Jauge de Verrouillage Optique -->
            <div id="scannerContainer" class="hidden space-y-3 pt-1">
                <div class="relative w-full overflow-hidden rounded-3xl border border-orange-300/60 shadow-2xl bg-black/50">
                    <div class="scan-laser"></div>
                    <div id="reader" class="w-full"></div>
                </div>

                <!-- Barre de progression de vérification optique (3 lectures identiques) -->
                <div class="ios27-tile p-3 rounded-2xl space-y-1.5">
                    <div class="flex justify-between items-center text-xs">
                        <span id="scanStatusText" class="font-bold text-orange-100">Cadrage du code-barres...</span>
                        <span id="scanStepCount" class="font-black text-orange-300">0/3</span>
                    </div>
                    <div class="w-full h-2 bg-black/40 rounded-full overflow-hidden">
                        <div id="scanProgressBar" class="h-full bg-gradient-to-r from-orange-500 to-amber-300 transition-all duration-200" style="width: 0%"></div>
                    </div>
                </div>
            </div>

            <!-- Recherche par Code EAN ou Marque -->
            <div class="flex gap-2.5">
                <input type="text" id="barcodeInput" placeholder="Code EAN ou marque (ex: Felix, Purina, Orijen)..." 
                    class="flex-1 ios27-tile rounded-[22px] px-4 py-3.5 text-sm text-white placeholder-orange-100/50 focus:outline-none focus:border-orange-300">
                <button onclick="searchByInput()" class="ios27-tile px-5 py-3.5 rounded-[22px] text-sm font-black text-orange-200">
                    Vérifier
                </button>
            </div>
        </div>

        <!-- LOADER DE CROISEMENT DES BASES -->
        <div id="loader" class="hidden ios27-window text-center py-9 px-5 space-y-3">
            <div class="animate-spin inline-block w-10 h-10 border-4 border-orange-400 border-t-transparent rounded-full"></div>
            <p id="loaderText" class="text-sm font-extrabold text-white">Vérification croisée sur 4 bases mondiales...</p>
            <p class="text-[11px] text-orange-200/80">Contrôle de la clé EAN • Extraction des protéines & glucides (ENA)</p>
        </div>

        <!-- RÉSULTAT COMPLET CERTIFIÉ -->
        <div id="resultCard" class="hidden space-y-5">
            
            <div class="ios27-window overflow-hidden">
                
                <!-- BANDEAU DE CERTIFICATION DU SCAN -->
                <div class="px-5 py-2.5 bg-gradient-to-r from-orange-500/25 via-amber-500/15 to-transparent border-b border-white/15 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="text-xs">🛡️</span>
                        <span id="certifTitle" class="text-[11px] font-black uppercase tracking-wider text-orange-200">
                            Article Vérifié & Contrôlé
                        </span>
                    </div>
                    <span id="certifEan" class="text-[10px] font-mono font-bold text-orange-100/90 ios27-tile px-2.5 py-0.5 rounded-full">
                        EAN Certifié
                    </span>
                </div>

                <!-- EN-TÊTE PRODUIT + ANNEAU DE SCORE iOS 27 -->
                <div class="p-5 flex gap-4 items-center border-b border-white/15">
                    <div class="relative w-24 h-24 rounded-[26px] ios27-tile p-1.5 flex items-center justify-center shrink-0 overflow-hidden">
                        <img id="prodImg" src="" alt="Produit" class="w-full h-full object-contain rounded-2xl drop-shadow-lg">
                    </div>

                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-1.5">
                            <span id="catTypeTag" class="text-[9px] font-black uppercase px-2 py-0.5 rounded-md bg-orange-500/30 text-orange-200 border border-orange-300/30">
                                Croquettes
                            </span>
                            <p id="prodBrand" class="text-[11px] font-extrabold uppercase tracking-widest text-orange-300 truncate"></p>
                        </div>
                        <h2 id="prodName" class="text-base font-black text-white leading-snug line-clamp-2 mt-1"></h2>

                        <!-- Score Anneau SVG + Verdict -->
                        <div class="mt-3 flex items-center gap-3">
                            <div class="relative w-14 h-14 flex items-center justify-center shrink-0">
                                <svg class="w-14 h-14 -rotate-90" viewBox="0 0 60 60">
                                    <circle cx="30" cy="30" r="24" stroke="rgba(255,255,255,0.15)" stroke-width="6" fill="none"/>
                                    <circle id="scoreRing" cx="30" cy="30" r="24" stroke="#f97316" stroke-width="6" fill="none"
                                        stroke-linecap="round" stroke-dasharray="150.8" stroke-dashoffset="30"/>
                                </svg>
                                <span id="scoreBadge" class="absolute text-xs font-black text-white">--</span>
                            </div>
                            <div>
                                <p id="scoreVerdict" class="font-black text-sm leading-tight"></p>
                                <p id="dataSourceBadge" class="text-[10px] text-orange-200/80 mt-0.5"></p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- JOURNAL DE VÉRIFICATION EN 4 POINTS -->
                <div class="px-5 py-3 bg-black/25 border-b border-white/15 grid grid-cols-2 gap-2 text-[11px]">
                    <div class="flex items-center gap-1.5 text-orange-100">
                        <span id="chk1">✅</span> <span id="chk1Txt">Clé code-barres valide</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-orange-100">
                        <span id="chk2">✅</span> <span id="chk2Txt">Bases croisées (4/4)</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-orange-100">
                        <span id="chk3">✅</span> <span id="chk3Txt">Calcul Glucides (ENA)</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-orange-100">
                        <span id="chk4">✅</span> <span id="chk4Txt">Espèce : Chat vérifié</span>
                    </div>
                </div>

                <!-- BENTO GRID DES 6 CONSTITUANTS + ÉNERGIE -->
                <div class="p-4 bg-black/15 border-b border-white/15 space-y-2.5">
                    <div class="flex items-center justify-between px-1">
                        <span class="text-[11px] font-black uppercase tracking-wider text-orange-200">
                            📊 Bilan Nutritionnel Complet
                        </span>
                        <div class="flex items-center gap-2">
                            <span id="valKcal" class="text-[10px] font-extrabold text-orange-200 ios27-tile px-2.5 py-0.5 rounded-full">
                                -- kcal/100g
                            </span>
                            <button onclick="toggleManualEdit()" class="text-[11px] font-bold text-orange-300 underline">
                                ✏️ Ajuster
                            </button>
                        </div>
                    </div>

                    <!-- 3 Macronutriments Clés -->
                    <div class="grid grid-cols-3 gap-2 text-center">
                        <div class="ios27-tile py-2.5 px-1 rounded-2xl">
                            <p class="text-[10px] text-orange-200/90 uppercase font-extrabold">Protéines</p>
                            <p id="valProt" class="font-black text-base text-white mt-0.5">--%</p>
                            <p id="lblProt" class="text-[9px] font-bold text-orange-200/80"></p>
                        </div>
                        <div class="ios27-tile py-2.5 px-1 rounded-2xl border border-orange-400/50">
                            <p class="text-[10px] text-orange-300 uppercase font-extrabold">Glucides (ENA)</p>
                            <p id="valCarbs" class="font-black text-base text-white mt-0.5">--%</p>
                            <p id="lblCarbs" class="text-[9px] font-bold text-orange-200/80"></p>
                        </div>
                        <div class="ios27-tile py-2.5 px-1 rounded-2xl">
                            <p class="text-[10px] text-orange-200/90 uppercase font-extrabold">Lipides</p>
                            <p id="valFat" class="font-black text-base text-white mt-0.5">--%</p>
                            <p id="lblFat" class="text-[9px] font-bold text-orange-200/80"></p>
                        </div>
                    </div>

                    <!-- 3 Indicateurs Secondaires -->
                    <div class="grid grid-cols-3 gap-2 text-center">
                        <div class="ios27-tile py-2 px-1 rounded-xl">
                            <p class="text-[9px] text-orange-200/75 uppercase font-bold">Cendres (Minéraux)</p>
                            <p id="valAsh" class="font-bold text-xs text-white mt-0.5">--%</p>
                        </div>
                        <div class="ios27-tile py-2 px-1 rounded-xl">
                            <p class="text-[9px] text-orange-200/75 uppercase font-bold">Fibres Brutes</p>
                            <p id="valFiber" class="font-bold text-xs text-white mt-0.5">--%</p>
                        </div>
                        <div class="ios27-tile py-2 px-1 rounded-xl">
                            <p class="text-[9px] text-orange-200/75 uppercase font-bold">Humidité</p>
                            <p id="valMoist" class="font-bold text-xs text-white mt-0.5">--%</p>
                        </div>
                    </div>

                    <!-- Éditeur manuel de précision -->
                    <div id="manualEditBox" class="hidden pt-2.5 mt-2 border-t border-white/15 space-y-2">
                        <p class="text-[11px] text-orange-100/90">
                            Ajustez avec les valeurs exactes inscrites au dos de votre paquet :
                        </p>
                        <div class="grid grid-cols-3 gap-2">
                            <div>
                                <label class="text-[10px] text-orange-200">Protéines %</label>
                                <input type="number" step="0.1" id="inpProt" class="w-full ios27-tile rounded-xl px-2.5 py-1.5 text-xs text-white">
                            </div>
                            <div>
                                <label class="text-[10px] text-orange-200">Lipides %</label>
                                <input type="number" step="0.1" id="inpFat" class="w-full ios27-tile rounded-xl px-2.5 py-1.5 text-xs text-white">
                            </div>
                            <div>
                                <label class="text-[10px] text-orange-200">Cendres %</label>
                                <input type="number" step="0.1" id="inpAsh" class="w-full ios27-tile rounded-xl px-2.5 py-1.5 text-xs text-white">
                            </div>
                            <div>
                                <label class="text-[10px] text-orange-200">Fibres %</label>
                                <input type="number" step="0.1" id="inpFiber" class="w-full ios27-tile rounded-xl px-2.5 py-1.5 text-xs text-white">
                            </div>
                            <div>
                                <label class="text-[10px] text-orange-200">Humidité %</label>
                                <input type="number" step="0.1" id="inpMoist" class="w-full ios27-tile rounded-xl px-2.5 py-1.5 text-xs text-white">
                            </div>
                            <div class="flex items-end">
                                <button onclick="applyManualValues()" class="w-full ios27-cta text-white font-bold text-xs py-2 rounded-xl">
                                    Valider
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- CE QUI VA BIEN & CE QUI NE VA PAS -->
                <div class="p-5 space-y-4">
                    <div class="ios27-tile p-4 rounded-[24px] border-l-4 border-l-orange-400">
                        <h3 class="text-xs font-black uppercase tracking-wider text-orange-300 mb-2.5 flex items-center gap-1.5">
                            <span>🔥</span> Ce qui va bien
                        </h3>
                        <ul id="prosList" class="space-y-2 text-sm text-white"></ul>
                    </div>

                    <div class="ios27-tile p-4 rounded-[24px] border-l-4 border-l-rose-400">
                        <h3 class="text-xs font-black uppercase tracking-wider text-rose-300 mb-2.5 flex items-center gap-1.5">
                            <span>⚠️</span> Ce qui ne va pas
                        </h3>
                        <ul id="consList" class="space-y-2 text-sm text-white"></ul>
                    </div>

                    <div class="pt-1 px-1">
                        <p class="text-xs font-bold text-orange-200/90 mb-1">Ingrédients inspectés :</p>
                        <p id="rawIngredients" class="text-xs text-orange-100/75 leading-relaxed italic"></p>
                    </div>
                </div>
            </div>

            <!-- SECTION MEILLEURES ALTERNATIVES -->
            <div id="alternativesSection" class="ios27-window p-5 space-y-3.5">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-sm font-black uppercase tracking-wider text-orange-300 flex items-center gap-1.5">
                            <span>✨</span> Meilleures Alternatives
                        </h3>
                        <p id="altSubtitle" class="text-xs text-orange-100/80 mt-0.5">
                            Sélection vétérinaire vérifiée pour remplacer ce produit
                        </p>
                    </div>
                    <span class="text-[11px] font-bold ios27-tile px-2.5 py-1 rounded-full text-orange-200">
                        Certifié 9+/10
                    </span>
                </div>

                <div id="alternativesList" class="space-y-3"></div>
            </div>

        </div>

    </main>

    <script>
        let html5QrCode = null;
        let isScanning = false;
        let current
